# LearnCosmos HTTPS config template.
# Certbot may generate equivalent ssl directives automatically.

server {
    listen 80;
    server_name learncosmos.co.kr www.learncosmos.co.kr;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name learncosmos.co.kr www.learncosmos.co.kr;

    client_max_body_size 600m;

    ssl_certificate /etc/letsencrypt/live/learncosmos.co.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/learncosmos.co.kr/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
